# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/rsv_db

# JWT Secrets
JWT_SECRET=your_super_secret_jwt_access_token_key_here
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_token_key_here
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt salt rounds
BCRYPT_SALT_ROUNDS=10

# CORS
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5500
